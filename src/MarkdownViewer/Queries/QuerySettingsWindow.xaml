<Window x:Class="MarkdownViewer.Queries.QuerySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Query settings"
        Width="980" Height="680"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <!-- The settings page of a saved query: connection on the left, SQL and template on the right. -->
    <DockPanel Margin="12">

        <!-- Dialog buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#707070" TextWrapping="Wrap" MaxWidth="560"
                       Text="The query runs inside a transaction that is always rolled back, so it cannot keep changes to the database." />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Save and _run" IsDefault="True" MinWidth="110" Padding="10,3" Click="SaveButton_Click" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: name, connection, result type and limits -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Name (shown on the bookshelf)" Margin="0,0,0,2" />
                    <TextBox x:Name="QueryNameBox" Padding="2" />

                    <GroupBox Header="SQL Server connection" Margin="0,12,0,0" Padding="6">
                        <StackPanel>
                            <!-- Shown when a saved connection could not be decrypted -->
                            <TextBlock x:Name="ConnectionProblemText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#B00020" Margin="0,0,0,8" />

                            <TextBlock Text="Server (e.g. SQLSERVER01 or SQLSERVER01\INSTANCE)" Margin="0,0,0,2" />
                            <TextBox x:Name="ServerNameBox" Padding="2" />

                            <TextBlock Text="Database" Margin="0,8,0,2" />
                            <TextBox x:Name="DatabaseNameBox" Padding="2" />

                            <TextBlock Text="Log in with" Margin="0,8,0,2" />
                            <ComboBox x:Name="AuthenticationChooser" SelectionChanged="AuthenticationChooser_SelectionChanged">
                                <ComboBoxItem Content="Windows login (recommended)" />
                                <ComboBoxItem Content="SQL Server login (user name and password)" />
                            </ComboBox>

                            <!-- Only for SQL Server logins -->
                            <StackPanel x:Name="SqlLoginPanel" Visibility="Collapsed">
                                <TextBlock Text="User name" Margin="0,8,0,2" />
                                <TextBox x:Name="UserNameBox" Padding="2" />
                                <TextBlock Text="Password" Margin="0,8,0,2" />
                                <PasswordBox x:Name="PasswordInput" Padding="2" />
                            </StackPanel>

                            <CheckBox x:Name="TrustServerCertificateBox" Margin="0,10,0,0"
                                      Content="Trust the server's certificate"
                                      ToolTip="Tick this if the connection fails with a certificate error. Many company servers use a certificate that Windows does not know." />

                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="TestConnectionButton" DockPanel.Dock="Left" Content="_Test connection" Padding="10,3" Click="TestConnectionButton_Click" />
                                <TextBlock x:Name="TestConnectionResultText" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="What the query returns" Margin="0,12,0,0" Padding="6">
                        <StackPanel>
                            <RadioButton x:Name="TableModeButton" GroupName="ResultMode" Checked="ResultModeButton_Checked"
                                         Content="Rows and columns (shown as a table, or through the row template)" />
                            <RadioButton x:Name="MarkdownModeButton" GroupName="ResultMode" Margin="0,6,0,0" Checked="ResultModeButton_Checked">
                                <TextBlock TextWrapping="Wrap" Text="Ready-made Markdown (the first column of each row is shown as it is, one row per line)" />
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Limits" Margin="0,12,0,0" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Most rows to show" VerticalAlignment="Center" />
                            <TextBox x:Name="MaximumRowCountBox" Grid.Row="0" Grid.Column="1" Padding="2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stop after (seconds)" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBox x:Name="TimeoutSecondsBox" Grid.Row="1" Grid.Column="1" Padding="2" Margin="0,6,0,0" />
                            <CheckBox x:Name="AllowAllStatementsBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Allow more than SELECT (e.g. EXEC of a stored procedure). Only for SQL you trust: changes are still rolled back, unless the SQL commits them itself." />
                            </CheckBox>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: the SQL, and the optional row template below it -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SQL" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="SqlTextBox" Grid.Row="1"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                         Padding="4"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         SpellCheck.IsEnabled="False" />

                <TextBlock Grid.Row="2" Text="Row template (optional)" FontWeight="SemiBold" Margin="0,12,0,2" />
                <TextBlock x:Name="RowTemplateHelpText" Grid.Row="3" TextWrapping="Wrap" Foreground="#707070" Margin="0,0,0,4"
                           Text="Leave empty for a table. Otherwise this Markdown is written once per row, with {ColumnName} replaced by the value, e.g. &quot;## {Title}&quot; on one line and &quot;{Description}&quot; on the next." />
                <TextBox x:Name="RowTemplateBox" Grid.Row="4"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                         Padding="4"
                         VerticalScrollBarVisibility="Auto"
                         SpellCheck.IsEnabled="False" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
