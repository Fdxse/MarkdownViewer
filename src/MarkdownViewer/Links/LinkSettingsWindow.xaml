<Window x:Class="MarkdownViewer.Links.LinkSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Links"
        Width="680" Height="380"
        MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <DockPanel Margin="12">
        <!-- Short explanation of the dialog -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
            These links are listed in the <Bold>Links</Bold> menu, in this order, and open in your
            default browser. Type in the empty last row to add one. Use Move up / Move down to reorder.
        </TextBlock>

        <!-- Dialog buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="_Remove selected" Padding="10,3" Click="RemoveButton_Click" />
            <Button DockPanel.Dock="Left" Content="Move _up" Padding="10,3" Margin="8,0,0,0" Click="MoveUpButton_Click" />
            <Button DockPanel.Dock="Left" Content="Move _down" Padding="10,3" Margin="8,0,0,0" Click="MoveDownButton_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" MinWidth="80" Padding="10,3" Click="OkButton_Click" />
        </DockPanel>

        <!-- The link list. The empty last row adds a new link. -->
        <DataGrid x:Name="LinkGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
