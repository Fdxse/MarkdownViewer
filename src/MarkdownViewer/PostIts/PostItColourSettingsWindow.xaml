<Window x:Class="MarkdownViewer.PostIts.PostItColourSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Post-it colours"
        Width="680" Height="420"
        MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <DockPanel Margin="12">
        <!-- Short explanation of the dialog -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
            These are the colours a post-it note can be given (right-click a note → <Bold>Colour</Bold>).
            The standard <Bold>yellow</Bold> is always there and is used for every note without a colour of its own.
            Give each colour a name, a hex value such as <Bold>#B8E0FF</Bold>, and a category that says what it means.
            Light colours read best. Type in the empty last row to add a colour. Notes in a removed colour turn yellow again.
        </TextBlock>

        <!-- Dialog buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="_Remove selected" Padding="10,3" Click="RemoveButton_Click" />
            <Button DockPanel.Dock="Left" Content="Move _up" Padding="10,3" Margin="8,0,0,0" Click="MoveUpButton_Click" />
            <Button DockPanel.Dock="Left" Content="Move _down" Padding="10,3" Margin="8,0,0,0" Click="MoveDownButton_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" MinWidth="80" Padding="10,3" Click="OkButton_Click" />
        </DockPanel>

        <!-- The palette, in the order the colours are listed in a note's Colour menu. The empty last row adds a colour. -->
        <DataGrid x:Name="ColourGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <!-- A preview of the colour, updated while the hex value is typed -->
                <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="28" Height="16" Margin="2" BorderBrush="#99000000" BorderThickness="1"
                                    Background="{Binding SwatchBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                <DataGridTextColumn Header="Hex (#RRGGBB)" Binding="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
