<Window x:Class="MarkdownViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarkdownViewer"
        Title="Markdown Viewer"
        Icon="Assets/AppIcon.ico"
        Width="1100" Height="800"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Activated="Window_Activated"
        Closing="Window_Closing">

    <!-- Keyboard shortcuts and menu commands are routed through these bindings. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAsCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Print" Executed="PrintCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="CloseCommand_Executed" />
        <CommandBinding Command="local:AppCommands.ToggleEditMode" Executed="ToggleEditModeCommand_Executed" />
        <CommandBinding Command="local:AppCommands.Reload" Executed="ReloadCommand_Executed" CanExecute="ReloadCommand_CanExecute" />
        <CommandBinding Command="local:AppCommands.ToggleBookshelf" Executed="ToggleBookshelfCommand_Executed" />
        <CommandBinding Command="local:AppCommands.AddToBookshelf" Executed="AddToBookshelfCommand_Executed" CanExecute="AddToBookshelfCommand_CanExecute" />
        <CommandBinding Command="local:AppCommands.OpenTodoList" Executed="OpenTodoListCommand_Executed" />
        <CommandBinding Command="local:AppCommands.AddTodoTask" Executed="AddTodoTaskCommand_Executed" />
        <CommandBinding Command="local:AppCommands.GlobalSearch" Executed="GlobalSearchCommand_Executed" />
    </Window.CommandBindings>

    <!-- Ctrl+Shift+S is not a built-in gesture for Save As, so it is added here. -->
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.SaveAs" Gesture="Ctrl+Shift+S" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Main menu -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="ApplicationCommands.New" />
                <MenuItem Header="_Open..." Command="ApplicationCommands.Open" />
                <MenuItem Header="_Reload" Command="local:AppCommands.Reload" />
                <Separator />
                <MenuItem Header="Add to _bookshelf" Command="local:AppCommands.AddToBookshelf" />
                <MenuItem Header="Add files to boo_kshelf..." Click="AddFilesToBookshelfButton_Click" />
                <!-- Trash and archive for the open document -->
                <MenuItem Header="Arc_hive this document" Click="ArchiveOpenDocumentMenuItem_Click"
                          ToolTip="Move the open file to the Archive folder next to the exe; it can still be searched and restored" />
                <MenuItem Header="Move this document to the _trash" Click="TrashOpenDocumentMenuItem_Click"
                          ToolTip="Move the open file to the Trash; it can be restored from the Trash bookshelf" />
                <!-- Backup: zips every bookshelf file plus settings.json into a timestamped zip next to the exe -->
                <MenuItem Header="_Zip all (backup bookshelf and settings)" Click="ZipAllMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Save" Command="ApplicationCommands.Save" />
                <MenuItem Header="Save _As..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Print..." Command="ApplicationCommands.Print" />
                <Separator />
                <MenuItem Header="E_xit" Command="ApplicationCommands.Close" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="EditModeMenuItem" Header="_Edit mode (side by side)" Command="local:AppCommands.ToggleEditMode" IsCheckable="False" />
                <MenuItem x:Name="BookshelfMenuItem" Header="_Bookshelf and properties" Command="local:AppCommands.ToggleBookshelf" IsCheckable="False" />
                <Separator />
                <MenuItem Header="Zoom _in" Command="NavigationCommands.IncreaseZoom" CommandTarget="{Binding ElementName=DocumentReader}" InputGestureText="Ctrl+Wheel up" />
                <MenuItem Header="Zoom _out" Command="NavigationCommands.DecreaseZoom" CommandTarget="{Binding ElementName=DocumentReader}" InputGestureText="Ctrl+Wheel down" />
                <MenuItem Header="_Reset zoom" Click="ResetZoomMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Find..." Command="ApplicationCommands.Find" CommandTarget="{Binding ElementName=DocumentReader}" />
            </MenuItem>
            <!-- Global search over every bookshelf, the todo list and saved queries, using search-index.json next to the exe -->
            <MenuItem Header="_Search">
                <MenuItem Header="_Search all documents..." Command="local:AppCommands.GlobalSearch" InputGestureText="Ctrl+Shift+F" />
                <MenuItem Header="_Find in this document..." Command="ApplicationCommands.Find" CommandTarget="{Binding ElementName=DocumentReader}" />
                <Separator />
                <MenuItem Header="_Refresh search index" Click="RefreshSearchIndexMenuItem_Click"
                          ToolTip="Read every document again and rewrite search-index.json next to the exe" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <!-- Text macros such as "@730" that expand while typing in the editor -->
                <MenuItem Header="_Macros..." Click="MacroSettingsMenuItem_Click" />
            </MenuItem>
            <!-- The todo list: a plain todo.md next to the exe. New tasks go to the top of a chosen section. -->
            <MenuItem Header="T_odo">
                <MenuItem Header="_Add task..." Command="local:AppCommands.AddTodoTask" InputGestureText="Ctrl+Shift+T" />
                <MenuItem Header="_Open todo list" Command="local:AppCommands.OpenTodoList" InputGestureText="Ctrl+T" />
                <Separator />
                <MenuItem Header="_Section for new tasks..." Click="TodoSectionMenuItem_Click" />
                <MenuItem Header="Archive _done tasks" Click="ArchiveDoneTasksMenuItem_Click"
                          ToolTip="Move the ticked tasks of todo.md (with their sub-tasks) to Archive\todo-archive.md" />
            </MenuItem>
            <!-- Saved links that open in the default browser. Filled from the settings in code (RebuildLinksMenu). -->
            <MenuItem x:Name="LinksMenu" Header="_Links" />
        </Menu>

        <!-- Status bar along the bottom -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="FilePathStatusText" Text="No file" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DocumentInfoStatusText" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main area: bookshelf and properties (left), editor and viewer (right) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BookshelfColumn" Width="280" MinWidth="150" />
                <ColumnDefinition x:Name="BookshelfSplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Bookshelf panel: Markdown files from anywhere on disk, and the properties of the open document -->
            <Grid x:Name="BookshelfPanel" Grid.Column="0" Background="#F7F7F7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>

                <!-- Bookshelf header: shelf drop-down, shelf menu, and add/remove buttons -->
                <DockPanel Grid.Row="0" Margin="8,6,6,4">
                    <Button x:Name="RemoveFilesButton" DockPanel.Dock="Right" Content="Remove" Padding="6,1" Margin="4,0,0,0"
                            ToolTip="Remove the selected files from this bookshelf (the files themselves are not deleted)"
                            Click="RemoveFromBookshelfButton_Click" />
                    <Button x:Name="AddFilesButton" DockPanel.Dock="Right" Content="Add..." Padding="6,1"
                            ToolTip="Add Markdown files to this bookshelf"
                            Click="AddFilesToBookshelfButton_Click" />
                    <!-- Opens a menu to create, rename or delete bookshelves -->
                    <Button x:Name="ShelfMenuButton" DockPanel.Dock="Right" Content="⋯" Padding="6,1" Margin="4,0,4,0"
                            ToolTip="New, rename or delete bookshelves"
                            Click="ShelfMenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="_New bookshelf..." Click="NewShelfMenuItem_Click" />
                                <MenuItem Header="New _folder bookshelf..." Click="NewFolderShelfMenuItem_Click"
                                          ToolTip="A bookshelf that always lists the Markdown files in a folder you choose" />
                                <MenuItem Header="New _query bookshelf..." Click="NewQueryShelfMenuItem_Click"
                                          ToolTip="A bookshelf of saved SQL Server queries; opening one runs it and shows the result as a document" />
                                <MenuItem Header="New _post-it board..." Click="NewPostItBoardMenuItem_Click"
                                          ToolTip="A folder bookshelf whose Markdown files are shown as yellow post-it notes instead of one document at a time" />
                                <Separator />
                                <MenuItem Header="_Rename this bookshelf..." Tag="RenameShelf" Click="RenameShelfMenuItem_Click" />
                                <MenuItem Header="_Delete this bookshelf..." Tag="DeleteShelf" Click="DeleteShelfMenuItem_Click"
                                          ToolTip="Move this bookshelf to the trash (the files themselves are not touched)" />
                                <MenuItem Header="_Empty the trash..." Tag="EmptyTrash" Click="EmptyTrashMenuItem_Click"
                                          ToolTip="Delete everything in the Trash for good" />
                                <Separator />
                                <!-- Only for folder bookshelves -->
                                <MenuItem Header="Include _subfolders" Tag="IncludeSubfolders" Click="IncludeSubfoldersMenuItem_Click" />
                                <MenuItem Header="_Open the folder" Tag="OpenShelfFolder" Click="OpenShelfFolderMenuItem_Click" />
                                <!-- Folder bookshelves only: switches between a plain file list and the post-it board -->
                                <MenuItem Header="Show as post-it _board" Tag="ShowAsPostItBoard" Click="ShowAsPostItBoardMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Which bookshelf is shown. Standard is first and is shown at startup. -->
                    <ComboBox x:Name="ShelfChooser"
                              FontWeight="SemiBold"
                              VerticalContentAlignment="Center"
                              ToolTip="Choose a bookshelf"
                              SelectionChanged="ShelfChooser_SelectionChanged" />
                </DockPanel>

                <!-- The list of files. Click a file to open it; drag it up or down to reorder; drop files here to add them. -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="BookshelfList"
                             SelectionMode="Extended"
                             BorderThickness="0,1,0,0"
                             BorderBrush="#E0E0E0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="BookshelfList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="BookshelfList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="BookshelfList_PreviewMouseLeftButtonUp"
                             DragOver="BookshelfList_DragOver"
                             DragLeave="BookshelfList_DragLeave"
                             Drop="BookshelfList_Drop"
                             KeyDown="BookshelfList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Only the file name is shown; the full path is in the tooltip and the properties panel. -->
                                <StackPanel x:Name="EntryPanel" Margin="2,3" ToolTip="{Binding ToolTipText}">
                                    <TextBlock x:Name="FileNameText" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="MissingFileText" Text="File not found" FontSize="11" Foreground="#B00020" Visibility="Collapsed" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <!-- Grey out files that were moved or deleted -->
                                    <DataTrigger Binding="{Binding FileExists}" Value="False">
                                        <Setter TargetName="EntryPanel" Property="Opacity" Value="0.6" />
                                        <Setter TargetName="FileNameText" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="MissingFileText" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="BookshelfContextMenu_Opened">
                                <MenuItem Header="_Open" Click="OpenBookshelfEntryMenuItem_Click" />
                                <!-- Only for queries (query bookshelves) -->
                                <MenuItem Header="_Edit query..." Tag="QueryOnly" Click="EditQueryMenuItem_Click" />
                                <!-- Only for files -->
                                <MenuItem Header="Show in _folder" Tag="FileOnly" Click="ShowBookshelfEntryInFolderMenuItem_Click" />
                                <MenuItem Header="_Copy path" Tag="FileOnly" Click="CopyBookshelfEntryPathMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="_Sort by name (A-Z)" Tag="EditsShelfFiles" Click="SortBookshelfByNameMenuItem_Click" />
                                <Separator />
                                <!-- Filled with the other bookshelves when the menu opens (BookshelfContextMenu_Opened) -->
                                <MenuItem Header="_Add to bookshelf" Tag="CopyToShelf" />
                                <MenuItem Header="_Move to bookshelf" Tag="MoveToShelf" />
                                <Separator />
                                <MenuItem Header="_Remove from this bookshelf" InputGestureText="Del" Tag="EditsShelfFiles" Click="RemoveFromBookshelfButton_Click" />
                                <!-- Trash and archive (the Trash shelf has its own menu, built in code) -->
                                <Separator />
                                <MenuItem Header="Arc_hive" Tag="ArchiveFiles" Click="ArchiveBookshelfEntriesMenuItem_Click"
                                          ToolTip="Move the selected files to the Archive folder; they can still be searched and restored" />
                                <MenuItem Header="Restore from arc_hive" Tag="RestoreFromArchive" Click="RestoreFromArchiveMenuItem_Click"
                                          ToolTip="Move the selected files back to where they were archived from" />
                                <MenuItem Header="Move to _trash" InputGestureText="Ctrl+Del" Click="MoveBookshelfEntriesToTrashMenuItem_Click"
                                          ToolTip="Move the selected files (or queries) to the Trash; they can be restored from the Trash bookshelf" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- Shown instead of the list while the bookshelf is empty -->
                    <TextBlock x:Name="BookshelfEmptyHint"
                               Margin="12"
                               TextWrapping="Wrap"
                               Foreground="#707070"
                               IsHitTestVisible="False"
                               Text="This bookshelf is empty. Click Add..., press Ctrl+D to add the open file, or drop Markdown files (or a folder) here." />
                </Grid>

                <!-- Lets the user share the height between the list and the properties -->
                <GridSplitter Grid.Row="2"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="#E0E0E0" />

                <!-- Properties of the open document -->
                <DockPanel Grid.Row="3">
                    <DockPanel DockPanel.Dock="Top" Margin="8,6,6,4">
                        <Button DockPanel.Dock="Right" Content="Show in folder" Padding="6,1" x:Name="ShowInFolderButton"
                                ToolTip="Open the folder of this file in Explorer"
                                Click="ShowCurrentFileInFolderButton_Click" />
                        <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- Filled in code: one row per property, label on the left and value on the right -->
                        <Grid x:Name="PropertiesGrid" Margin="8,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <GridSplitter x:Name="BookshelfSplitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#E0E0E0"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Document area: the "back to the board" bar on top, and below it either the document or the post-it board -->
            <DockPanel Grid.Column="2">
                <!-- Shown above a document opened from a post-it board, so the user can get back to the notes -->
                <Border x:Name="BackToPostItBoardBar"
                        DockPanel.Dock="Top"
                        Visibility="Collapsed"
                        Background="#FFF68F"
                        BorderBrush="#E0D46A"
                        BorderThickness="0,0,0,1"
                        Padding="8,4">
                    <DockPanel>
                        <Button Content="← Back to the post-it board" Padding="8,2"
                                ToolTip="Show all the notes on this board again"
                                Click="BackToPostItBoardButton_Click" />
                        <TextBlock x:Name="BackToPostItBoardText" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="#5C5300" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <Grid>
                    <!-- Editor (left, hidden in view mode) and rendered document (right) -->
                    <Grid x:Name="ContentGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EditorColumn" Width="0" />
                            <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Plain text Markdown editor -->
                        <TextBox x:Name="MarkdownEditor"
                                 Grid.Column="0"
                                 Visibility="Collapsed"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="13"
                                 Padding="8"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 SpellCheck.IsEnabled="False"
                                 TextChanged="MarkdownEditor_TextChanged" />

                        <GridSplitter x:Name="EditorSplitter"
                                      Grid.Column="1"
                                      Width="5"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Stretch"
                                      Background="#E0E0E0"
                                      ResizeBehavior="PreviousAndNext" />

                        <!-- Rendered Markdown. FlowDocumentReader provides scrolling, zoom, find and page modes. -->
                        <FlowDocumentReader x:Name="DocumentReader"
                                            Grid.Column="2"
                                            ViewingMode="Scroll"
                                            IsFindEnabled="True"
                                            IsPrintEnabled="False"
                                            Background="White" />
                    </Grid>

                    <!-- The post-it board: one yellow note per Markdown file in the board's folder. Filled in code (MainWindow.PostItBoard.cs).
                         The notes lie on a free-form canvas: they can be moved anywhere, stacked and tilted (MainWindow.PostItBoardLayout.cs). -->
                    <DockPanel x:Name="PostItBoardView"
                               Visibility="Collapsed"
                               Background="#ECE5D3">
                        <!-- Board name, and the folder it shows; stays at the top while the notes scroll -->
                        <StackPanel DockPanel.Dock="Top" Margin="16,12,16,4">
                            <TextBlock x:Name="PostItBoardTitleText" FontSize="20" FontWeight="SemiBold" Foreground="#3D3A30" />
                            <TextBlock x:Name="PostItBoardSubtitleText" Margin="0,2,0,4" Foreground="#6B6553" TextWrapping="Wrap" />
                            <!-- Shown instead of the notes while the folder has no Markdown files -->
                            <TextBlock x:Name="PostItBoardEmptyHint" Margin="0,12" Foreground="#6B6553" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <!-- The notes, scrolling both ways when they are spread out further than the window -->
                        <ScrollViewer x:Name="PostItBoardScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Focusable="False">
                            <!-- Each note has its own place (Canvas.Left/Top), tilt and stacking (Panel.ZIndex). Size set in code to fit the notes. -->
                            <Canvas x:Name="PostItNotesCanvas" Margin="16,4,16,16" Background="Transparent" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
