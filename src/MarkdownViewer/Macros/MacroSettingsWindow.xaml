<Window x:Class="MarkdownViewer.Macros.MacroSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macros"
        Width="760" Height="420"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <DockPanel Margin="12">
        <!-- Explanation of how macros work -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
            While you type in the editor, a trigger is replaced by its replacement as soon as you
            type a space, Enter, Tab or punctuation after it. In both columns, <Bold>{n}</Bold> stands
            for a number: with the trigger <Bold>@{n}</Bold>, typing "@730 " inserts the replacement
            with 730 filled in. Ctrl+Z undoes an expansion.
        </TextBlock>

        <!-- Dialog buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="_Remove selected" Padding="10,3" Click="RemoveButton_Click" />
            <Button DockPanel.Dock="Left" Content="Open settings _folder" Padding="10,3" Margin="8,0,0,0" Click="OpenSettingsFolderButton_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" MinWidth="80" Padding="10,3" Click="OkButton_Click" />
        </DockPanel>

        <!-- The macro list. The empty last row adds a new macro. -->
        <DataGrid x:Name="MacroGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="140" />
                <DataGridTextColumn Header="Replacement" Binding="{Binding Replacement}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
