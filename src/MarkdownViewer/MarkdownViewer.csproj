<Project Sdk="Microsoft.NET.Sdk">

  <!-- General application settings -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MarkdownViewer</AssemblyName>
    <RootNamespace>MarkdownViewer</RootNamespace>
    <Product>Markdown Viewer</Product>
    <!-- Default version for local builds; CI overrides it with -p:Version=... -->
    <Version>1.0.0</Version>
    <!-- Lets the project be built on non-Windows machines (e.g. Linux CI agents) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Icon embedded in the .exe (Explorer, taskbar, Alt+Tab). Regenerate with tools/make_icon.py -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publish settings: one self-contained .exe that needs no installed .NET runtime -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF ships native DLLs; bundle them into the exe too so it stays a single file -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Shrinks the exe considerably at the cost of a slightly slower first start -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No separate .pdb next to the exe -->
    <DebugType>embedded</DebugType>
    <!-- Do not copy NuGet packages' XML API docs (e.g. WebView2's) next to the exe -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Start page shown when no file is open -->
    <EmbeddedResource Include="Assets\Welcome.md" LogicalName="MarkdownViewer.Welcome.md" />
    <!-- Same icon as a WPF resource so the window's title bar can show it -->
    <Resource Include="Assets\AppIcon.ico" />
    <!-- Mermaid diagram support: the hidden host page and mermaid.js (MIT licensed), served to WebView2 from the exe -->
    <EmbeddedResource Include="Assets\Mermaid\MermaidHost.html" LogicalName="MarkdownViewer.Mermaid.MermaidHost.html" />
    <EmbeddedResource Include="Assets\Mermaid\mermaid.min.js" LogicalName="MarkdownViewer.Mermaid.mermaid.min.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Markdown parser (BSD-2-Clause licensed), approved by the project owner -->
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <!-- Microsoft Edge WebView2 SDK (BSD-style license), approved by the project owner; runs mermaid.js to draw ```mermaid diagrams -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- Microsoft SQL Server client (MIT licensed), approved by the project owner; runs the saved queries on query bookshelves -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

</Project>
